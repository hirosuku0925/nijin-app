{
  "name": "nijin-app",
  "version": "1.0.0",
  "main": "main.js", // メインプロセスのファイル名
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.nijin.app.universal",
    "productName": "NijinApp",
    // --- ここを追加・確認 ---
    "files": [
      "main.js",
      "index.html",
      "preload.js",
      "renderer.js",
      "dist/**/*", // もしReact/Vueのビルド先が dist ならこれも必要
      "build/**/*"   // もしReact/Vueのビルド先が build ならこれも必要
    ],
    // ------------------------
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    }
  },
  // ... 依存関係など
}
